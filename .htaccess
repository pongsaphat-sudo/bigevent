DirectoryIndex index.php
Options -MultiViews -Indexes

<FilesMatch "^(config\.php|database\.sqlite|\.env.*)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteRule ^storage(?:/|$) - [F,L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^favicon\.ico$ /assets/img/favicon.svg [L]
    RewriteRule ^wp-content/uploads/.*\.(jpe?g|png|gif|webp|svg)$ /assets/img/og-default.png [L,NC]
    RewriteRule ^ index.php [L]
</IfModule>
